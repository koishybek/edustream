# Normalize line endings to LF in the repo (avoids CRLF churn across
# Flutter/Dart, Node, and shell tooling on Windows + CI).
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.otf binary
