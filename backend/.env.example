# Copy to `.env` and fill in. Secrets via env only — never commit `.env`.

# --- Database ---
# Local no-Docker cluster (infra/ helper scripts, this machine):
DATABASE_URL="postgresql://postgres@localhost:5433/edustream?schema=public"
# Docker (infra/docker-compose.yml):
# DATABASE_URL="postgresql://edustream:edustream@localhost:5432/edustream?schema=public"

# --- HTTP ---
PORT=4000
NODE_ENV=development
# Comma-separated allowed CORS origins (admin + mobile dev). "*" allows all.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth (Phase 1) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
